PROGRAM PRG_PackagingMachine
VAR_EXTERNAL
 I_Fresh : REAL;
 I_CommAge : REAL;
 I_StartPB : REAL;
 I_StopPB : REAL;
 I_ResetPB : REAL;
 I_Mode : REAL;
 I_GuardClosed : REAL;
 I_EStopOK : REAL;
 I_ProductPresent : REAL;
 I_FilmMark : REAL;
 I_FilmEnd : REAL;
 I_EndSealHome : REAL;
 I_ProductInSealZone : REAL;
 I_AxisError : REAL;
 I_FilmError : REAL;
 I_DoubleFeed : REAL;
 I_Jam : REAL;
 I_PackagedAck : REAL;
 I_RejectAck : REAL;
 I_FilmPosition : REAL;
 I_ProductPosition : REAL;
 I_EndSealActual : REAL;
 I_ProductLength : REAL;
 I_BagPitch : REAL;
 I_PackagingSpeed : REAL;
 I_FilmOffset : REAL;
 I_SealOffset : REAL;
 I_Dt : REAL;
 I_ColdReset : REAL;
 I_InfeedActual : REAL;
 I_CenterActual : REAL;
 I_DischargeActual : REAL;
 Q_InfeedRun : REAL;
 Q_FilmFeedEnable : REAL;
 Q_CenterSealEnable : REAL;
 Q_EndSealEnable : REAL;
 Q_CutterEnable : REAL;
 Q_DischargeRun : REAL;
 Q_Mode : REAL;
 Q_Alarm : REAL;
 Q_Count : REAL;
 Q_Reject : REAL;
 Q_FilmTarget : REAL;
 Q_EndSealTarget : REAL;
 Q_InfeedTarget : REAL;
 Q_CenterTarget : REAL;
 Q_DischargeTarget : REAL;
 Q_Speed : REAL;
 Q_Phase : REAL;
 Q_Running : REAL;
 Q_Scan : REAL;
 Q_Pitch : REAL;
 Q_ResetAllowed : REAL;
END_VAR
VAR
 Infeed : FB_InfeedConveyor;
 Film : FB_FilmFeed;
 Center : FB_CenterSeal;
 Discharge : FB_Discharge;
 Detection : FB_ProductDetection;
 Bag : FB_BagLengthControl;
 Sync : FB_AxisSynchronization;
 Seal : FB_EndSeal;
 Cutter : FB_Cutter;
 Alarm : FB_AlarmManager;
 Modes : FB_ModeManager;
 Cause : INT;
 Recovery : BOOL;
 NeedProduct : BOOL;
 NeedSensorLow : BOOL;
 Cold : BOOL;
 Done : BOOL;
 Pitch : REAL;
 Speed : REAL;
 StepSeconds : REAL;
 Good : BOOL;
END_VAR
(* Fixed real task: 20ms. Machine time advances only on fresh I/O.
   StepSeconds is 0.02 real-time / 0.20 accelerated; watchdog uses actual scan age. *)
Q_Scan := Q_Scan + 1.0;
Cold := I_Fresh > 0.0 AND I_ColdReset > 0.0 AND NOT Modes.Running;
IF Pitch = 0.0 OR Cold THEN Pitch := 120.0; Speed := 20.0; END_IF;
Good := I_ProductLength >= 10.0 AND I_ProductLength <= 100.0 AND I_BagPitch >= I_ProductLength + 30.0 AND I_BagPitch <= 300.0 AND I_PackagingSpeed >= 5.0 AND I_PackagingSpeed <= 10.0 AND ABS(I_SealOffset) <= 0.03 AND ABS(I_FilmOffset) <= 5.0;
IF NOT Modes.Running AND I_Fresh > 0.0 AND Good THEN
 Pitch := I_BagPitch; Speed := Pitch * I_PackagingSpeed / 60.0;
END_IF;
StepSeconds := LIMIT(0.001, I_Dt, 0.20);
Detection(Present := I_ProductPresent > 0.0, Run := Modes.Running, Fresh := I_Fresh > 0.0, StepSeconds := StepSeconds, Period := 60.0 / MAX(5.0,I_PackagingSpeed), Reset := Cold OR I_ResetPB > 0.0);
Cause := 0;
IF Detection.Missing THEN Cause := 1; NeedProduct := TRUE; END_IF;
IF Detection.StuckOn THEN Cause := 2; NeedSensorLow := TRUE; END_IF;
IF I_Fresh > 0.0 AND I_ProductPresent = 0.0 AND NOT Modes.Running THEN NeedSensorLow := FALSE; END_IF;
IF Cold THEN NeedProduct := FALSE; NeedSensorLow := FALSE; END_IF;
IF I_DoubleFeed > 0.0 THEN Cause := 3; END_IF;
IF I_FilmEnd > 0.0 THEN Cause := 4; END_IF;
IF ABS(I_FilmError) > 8.0 THEN Cause := 5; END_IF;
IF I_ProductInSealZone > 0.0 THEN Cause := 6; END_IF;
IF I_AxisError > 8.0 THEN Cause := 7; END_IF;
IF I_Jam > 0.0 THEN Cause := 8; END_IF;
IF I_GuardClosed < 1.0 OR I_EStopOK < 1.0 THEN Cause := 9; END_IF;
IF I_CommAge > 0.5 THEN Cause := 10; END_IF;
IF I_Fresh > 0.0 AND NOT Good THEN Cause := 11; END_IF;
Recovery := NOT NeedSensorLow AND Cause = 0 AND (NOT NeedProduct OR I_ProductPresent > 0.0) AND I_Fresh > 0.0;
Alarm(Cause := Cause, ResetPB := I_ResetPB > 0.0 AND I_Fresh > 0.0, RecoveryOK := Recovery, Cold := Cold);
IF Alarm.Alarm = 0 THEN NeedProduct := FALSE; END_IF;
Bag(Position := I_FilmPosition, Pitch := Pitch, Offset := I_FilmOffset, Reset := Cold);
Sync(Phase := Bag.Phase, Offset := I_SealOffset);
Done := Modes.Mode = 3 AND Bag.Boundary;
Modes(StartPB := I_StartPB > 0.0 AND I_Fresh > 0.0, StopPB := I_StopPB > 0.0, Requested := REAL_TO_INT(I_Mode), Alarm := Alarm.Alarm, SingleDone := Done, Cold := Cold);
Infeed(Enable := Modes.Running, Fresh := I_Fresh > 0.0, Reset := Cold, Speed := Speed, StepSeconds := StepSeconds);
Film(Enable := Modes.Running, Fresh := I_Fresh > 0.0, Reset := Cold, Speed := Speed, StepSeconds := StepSeconds);
Center(Enable := Modes.Running, Fresh := I_Fresh > 0.0, Reset := Cold, Speed := Speed, StepSeconds := StepSeconds);
Discharge(Enable := Modes.Running, Fresh := I_Fresh > 0.0, Reset := Cold, Speed := Speed, StepSeconds := StepSeconds);
Seal(Enable := Modes.Running OR Done, CamClose := Sync.Close, CamTarget := Sync.JawTarget);
Cutter(Enable := (Modes.Running OR Done) AND Alarm.Alarm = 0, Boundary := Bag.Boundary AND I_Fresh > 0.0, SealClose := Seal.Close);
IF Cold THEN Q_Count := 0.0; Q_Reject := 0.0; END_IF;
IF I_Fresh > 0.0 THEN Q_Count := Q_Count + I_PackagedAck; Q_Reject := Q_Reject + I_RejectAck; END_IF;
Q_InfeedRun := BOOL_TO_REAL(Infeed.Run); Q_FilmFeedEnable := BOOL_TO_REAL(Film.Run);
Q_CenterSealEnable := BOOL_TO_REAL(Center.Run); Q_DischargeRun := BOOL_TO_REAL(Discharge.Run);
Q_EndSealEnable := BOOL_TO_REAL(Seal.Close); Q_CutterEnable := BOOL_TO_REAL(Cutter.Pulse);
Q_Mode := INT_TO_REAL(Modes.Mode); Q_Alarm := INT_TO_REAL(Alarm.Alarm); Q_Running := BOOL_TO_REAL(Modes.Running);
Q_FilmTarget := Film.Target; Q_InfeedTarget := Infeed.Target; Q_CenterTarget := Center.Target; Q_DischargeTarget := Discharge.Target;
Q_EndSealTarget := Seal.Target; Q_Speed := Speed; Q_Phase := Sync.SealPhase; Q_Pitch := Pitch; Q_ResetAllowed := BOOL_TO_REAL(Recovery);
END_PROGRAM
